# Postgres connection (docker compose overrides this for the api container)
DATABASE_URL=postgresql://relay:relay_dev_pass@localhost:5432/relaydb
# Optional: change the "today" the seeded histories run up to (default 2026-11-01)
# SEED_REF_DATE=2026-11-01
# Override the chassis search limit (default 3 per IP per 10 min) - tests only
# CHASSIS_SEARCH_LIMIT=3
PORT=4000
